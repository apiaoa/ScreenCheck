    <!-- Home -->
    <string name="home_tagline">Check your screen for dead pixels, banding and specs — fully offline.</string>
    <string name="home_footer">No ads · No permissions · No network access</string>
    <string name="home_color_title">Dead Pixel Test</string>
    <string name="home_color_desc">Full-screen solid colors reveal dead pixels, bright spots and backlight bleed.</string>
    <string name="home_gray_title">Grayscale Test</string>
    <string name="home_gray_desc">16-step gray scale, gradient and mid gray expose banding and uneven backlight.</string>
    <string name="home_info_title">Display Info</string>
    <string name="home_info_desc">Resolution, density, refresh rate and HDR support at a glance.</string>

